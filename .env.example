# =============================================================================
# APP CONFIGURATION
# =============================================================================
# These variables configure your application. Copy this file to .env and fill
# in the values appropriate for your environment.

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# LOCAL (Docker). Una sola URL. El valor de abajo coincide con el servicio de
# Postgres de compose.yaml, asi que `bun run db:up` da una base que funciona sin
# tocar nada aca.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shipfree

# NEON (preview y produccion). SON DOS URLs Y NO SON INTERCAMBIABLES:
#
#   DATABASE_URL         host CON -pooler   -> la app
#   DIRECT_DATABASE_URL  host SIN -pooler   -> migraciones y drizzle-kit
#
# El pooler de Neon es PgBouncer en modo transaccion. La app tiene que ir por
# ahi o agota las conexiones cuando hay varias lambdas; las migraciones NO
# pueden ir por ahi porque son DDL en transaccion, que ese modo no sostiene.
#
# EN LOCAL SE DEJA VACIA. El migrador ignora el valor vacio y cae de vuelta a
# DATABASE_URL, asi que copiar este archivo a .env deja el flujo de Docker
# funcionando sin tocar nada.
#
# Esta declarada, y no comentada, a proposito: Vercel arma la lista de
# variables del proyecto leyendo las claves NO comentadas de este archivo. Si
# estuviera comentada, no aparecería al importar el repo, y el build caeria en
# `bun run migrate`, que es el paso que necesita el host sin pooler.
#
#   DATABASE_URL=postgresql://user:pass@ep-algo-123-pooler.region.aws.neon.tech/db?sslmode=require
#   DIRECT_DATABASE_URL=postgresql://user:pass@ep-algo-123.region.aws.neon.tech/db?sslmode=require
DIRECT_DATABASE_URL=

# -----------------------------------------------------------------------------
# APP URL
# -----------------------------------------------------------------------------
# Public URL of your application (used for OAuth callbacks, email links, etc.)
# For local development: http://localhost:3000
#
# EN VERCEL NO HACE FALTA: getBaseUrl() (src/lib/utils/urls.ts) la deduce de
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL en produccion y de
# NEXT_PUBLIC_VERCEL_BRANCH_URL en preview, asi que el paso a un dominio propio
# no pide tocar variables. Comentada para que Vercel no la liste al importar.
# Ponla solo para forzar una URL distinta.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# MAPS: no environment variable is required. MapLibre loads CARTO's public
# raster basemap directly; keep the attribution rendered by the map components.

# -----------------------------------------------------------------------------
# NODE ENVIRONMENT
# -----------------------------------------------------------------------------
# Set to 'development', 'production', or 'test'
# NODE_ENV=development

# INERTE: no se lee en ninguna parte del codigo. Comentada para que Vercel no
# la liste al importar el proyecto.
# NEXT_PUBLIC_ENV=development

# =============================================================================
# COBROS DE COMERCIO (ePayco Smart Checkout v2)
# =============================================================================
# Blank local configuration selects the fake adapter but leaves new operations
# disabled. `bun run test:e2e` injects its own isolated fake configuration and
# disposable database; never add COMMERCE_BROWSER_TEST to an env file.
#
# For manual fake testing in `bun dev`, set:
#   COMMERCE_PAYMENT_PROVIDER=fake
#   COMMERCE_PAYMENT_ENVIRONMENT=test
#   COMMERCE_FUNDING_CLASSIFICATION=sandbox
#   COMMERCE_PAYMENT_CONFIG_VERSION=local-fake-v1
#   COMMERCE_NEW_OPERATIONS_ENABLED=true
#
# For an account-backed local ePayco sandbox test, use epayco/test/sandbox,
# choose a durable config version, fill all four ePayco credentials, enable new
# operations, and set NEXT_PUBLIC_APP_URL to the public HTTPS tunnel origin.
# Every Vercel deployment requires ePayco; the fake adapter refuses Vercel and
# normal production processes. Never reuse credentials or a config version
# between test and live.
COMMERCE_PAYMENT_PROVIDER=
COMMERCE_PAYMENT_ENVIRONMENT=
COMMERCE_FUNDING_CLASSIFICATION=sandbox
COMMERCE_PAYMENT_CONFIG_VERSION=
# Kill switch for new orders. Callbacks, recovery, and refunds remain active.
COMMERCE_NEW_OPERATIONS_ENABLED=false
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
EPAYCO_MERCHANT_NAME=Tumbenla

# When credentials rotate, keep configurations for unresolved attempts here.
# This is a secret JSON array whose objects contain configVersion, accountId,
# environment, publicKey, privateKey, pKey, and merchantName.
EPAYCO_PREVIOUS_CONFIGS_JSON=

# Long random bearer authenticating /api/cron/commerce-recovery in Vercel.
# Generate independently per environment, for example: openssl rand -base64 32
CRON_SECRET=

# =============================================================================
# BETTER-AUTH CONFIGURATION
# =============================================================================
# Better-Auth is your authentication framework. These variables are required
# for secure session management and API endpoints.

# Secret key used to encrypt sessions and sign tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# INERTE: src/lib/auth/auth.ts pasa `baseURL: getBaseUrl()` explicitamente, y
# getBaseUrl() lee NEXT_PUBLIC_APP_URL. Better-Auth nunca consulta esta
# variable. La URL publica se configura arriba, en NEXT_PUBLIC_APP_URL.
# BETTER_AUTH_URL=http://localhost:3000

# Apex domain for sharing the session cookie across subdomains, e.g. .tumbenla.com
# Leave unset for a single host. Setting the wrong value breaks sign-in entirely.
# COOKIE_DOMAIN=

# =============================================================================
# TUMBENLA ADMIN
# =============================================================================
# Comma-separated emails allowed into /admin.
# Fails closed: unset or empty means nobody is an admin.
#
# SECURITY: this matches on the session email, so an account must also have a
# VERIFIED email to pass. Keep EMAIL_VERIFICATION_ENABLED=true in any deployed
# environment, otherwise anyone who knows an operator's address could register
# with it first and inherit the admin panel.
ADMIN_EMAILS=

# Obligatoria en cualquier entorno desplegado donde ADMIN_EMAILS tenga algo.
# Sin verificacion, cualquiera podria registrarse con el correo de un operador
# antes que el y heredar el panel.
EMAIL_VERIFICATION_ENABLED=true

# =============================================================================
# SOCIAL AUTH PROVIDERS
# -----------------------------------------------------------------------------
# Configure OAuth providers for social login (Google, GitHub, Microsoft, Facebook)

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth (Azure Active Directory)
# Get credentials from: https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_TENANT_ID=common  # Use 'common' for multi-tenant, or your specific tenant ID

# Facebook OAuth
# Get credentials from: https://developers.facebook.com/apps
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# =============================================================================
# OPTIONAL: OBSERVABILITY
# -----------------------------------------------------------------------------
# Leave the DSNs empty to keep Sentry disabled locally. For a local production
# build with source-map upload, also provide the organization, project, and a
# build-only auth token. The DSN is public; the auth token is secret.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=tumbenla
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=

# =============================================================================
# OPTIONAL: CLOUDFLARE R2 STORAGE
# -----------------------------------------------------------------------------
# Use R2 for file uploads/storage (S3-compatible)
# Get credentials from: https://dash.cloudflare.com/r2
# Las fotos de las noches viven aca. Sin esto, subir una foto falla con un
# mensaje claro y el resto del sitio sigue funcionando.
#
# ESTAS CLAVES VAN DESCOMENTADAS A PROPOSITO: Vercel arma la lista de variables
# del proyecto leyendo las claves NO comentadas de este archivo, asi que
# comentarlas significa que no aparecen al importar el repo y alguien las
# descubre cuando ya fallo una subida en produccion.
#
# El bucket publico necesita ademas una politica de CORS que permita PUT desde
# el dominio de produccion, el de preview y http://localhost:3000. La subida es
# firmada y va directa del navegador a R2; sin CORS falla ahi, con un error que
# no dice CORS por ninguna parte.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_URL=
R2_PUBLIC_BUCKET=
# Obligatorio para evidencia financiera: los originales nunca van al bucket público.
R2_PRIVATE_BUCKET=
# Dominio público que sirve únicamente copias revisadas y redactadas.
R2_STORAGE_BASE_URL=

# =============================================================================
# OPTIONAL: EMAIL PROVIDER
# -----------------------------------------------------------------------------
# Which email service sends transactional email.
#
# LEAVE THIS UNSET. It then defaults to Resend in every environment, so local
# testing exercises the same delivery path as production. The only thing that
# changes between environments is DEFAULT_FROM_EMAIL below.
#
# Set it only to override: 'nodemailer' routes to the local Mailpit container
# (offline, nothing is delivered), 'log' prints to the console.
# Options: resend, postmark, nodemailer, plunk, custom, log
# EMAIL_PROVIDER=nodemailer

# -----------------------------------------------------------------------------
# SENDER IDENTITY  (the one value that differs per environment)
# -----------------------------------------------------------------------------
# Resend only sends FROM a domain verified in its dashboard. You cannot send
# from a gmail.com or outlook.com address.
#
# Until you own a verified domain, use Resend's shared sender:
# El remitente vive en el SUBDOMINIO verificado en Resend, no en el apex: si
# algun dia un envio quema la reputacion, no se lleva por delante la del dominio
# principal, y deja el apex libre de conflictos de SPF para el buzon que recibe.
DEFAULT_FROM_EMAIL=hola@send.tumbenla.com
DEFAULT_FROM_NAME=Tumbenla
# A donde contesta quien le da a "responder". TIENE que ser distinto del de
# arriba: send.tumbenla.com envia pero no recibe nada.
DEFAULT_REPLY_TO=hola@tumbenla.com
#
# It delivers ONLY to the address on your own Resend account, which is enough
# to test signup, verification, and password reset against a real inbox.
#
# Once the company domain is verified, swap in an address on it:
# DEFAULT_FROM_EMAIL=noreply@yourcompany.com
# DEFAULT_FROM_NAME=Your Company

# -----------------------------------------------------------------------------
# OPTIONAL: LOCAL MAIL CATCHER (Mailpit)
# -----------------------------------------------------------------------------
# Only used when EMAIL_PROVIDER=nodemailer, to work offline or avoid spending
# Resend quota. `bun run db:up` starts the container either way; read captured
# mail at http://localhost:8025
# COMENTADAS a proposito: apuntan al contenedor local y en un despliegue no
# existen, pero Vercel listaria cada una al importar el repo. Descomentalas
# solo si vas a usar EMAIL_PROVIDER=nodemailer en local.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=mailpit
# SMTP_PASS=mailpit
# SMTP_SECURE=false

# ----- RESEND (the default provider, required in every environment) -----
# Get an API key from: https://resend.com/api-keys
# Use a separate key per environment so one can be revoked without the other.
# Without this key the app falls back to Mailpit locally, and in production to
# the log provider — where mail is silently written to logs instead of sent.
RESEND_API_KEY=
# RESEND_DOMAIN=mail.yourcompany.com  # alternative to DEFAULT_FROM_EMAIL;
                                      # makes the sender noreply@<domain>

# ----- POSTMARK -----
# Get API token from: https://postmarkapp.com/support/artifacts/api-tokens
# POSTMARK_API_TOKEN=your-postmark-token

# ----- PLUNK -----
# Get API key from: https://plunk.com/settings/api
# PLUNK_API_KEY=your-plunk-api-key

# ----- NODEMAILER / SMTP (a real SMTP server) -----
# The SMTP_* values near the top of this file point at the local Mailpit
# container. Replace them with these to use a real SMTP server instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false  # Set to "true" for TLS/SSL on port 465

# ----- EMAIL DEFAULTS -----
# Sender identity is configured in the SENDER IDENTITY section near the top.


# =============================================================================
# OPTIONAL: PAYMENT PROVIDERS
# -----------------------------------------------------------------------------
# Configure payment providers for your application's billing/subscription features
# Choose one: stripe, polar, lemonsqueezy, or creem
# PAYMENT_PROVIDER=stripe

# ----- STRIPE (for application payments) -----
# Get credentials from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Public Stripe price IDs (for client-side display)
# NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_STARTER_YEARLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# ----- POLAR -----
# Get credentials from: https://polar.sh/settings
# POLAR_ACCESS_TOKEN=your-polar-access-token
# POLAR_WEBHOOK_SECRET=your-webhook-secret
# POLAR_ORGANIZATION_ID=your-org-id
# POLAR_PRODUCT_ID=your-product-id
# POLAR_ENVIRONMENT=production  # or 'sandbox'

# Public Polar product IDs
# NEXT_PUBLIC_POLAR_PRODUCT_STARTER_MONTHLY=prod_...
# NEXT_PUBLIC_POLAR_PRODUCT_PRO_MONTHLY=prod_...
# NEXT_PUBLIC_POLAR_PRODUCT_ENTERPRISE_MONTHLY=prod_...

# ----- LEMON SQUEEZY -----
# Get credentials from: https://app.lemonsqueezy.com/settings/api
# LEMONSQUEEZY_API_KEY=your-api-key
# LEMONSQUEEZY_STORE_ID=your-store-id
# LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# Public Lemon Squeezy product IDs
# NEXT_PUBLIC_LEMONSQUEEZY_PRODUCT_STARTER_MONTHLY=prod_...
# NEXT_PUBLIC_LEMONSQUEEZY_PRODUCT_PRO_MONTHLY=prod_...
# NEXT_PUBLIC_LEMONSQUEEZY_PRODUCT_ENTERPRISE_MONTHLY=prod_...

# ----- CREEM -----
# EU-based Merchant of Record. Get credentials from: https://creem.io (Developers menu)
# NOTE: test mode and production use DIFFERENT API keys.
# CREEM_API_KEY=creem_...
# CREEM_WEBHOOK_SECRET=whsec_...
# Set to true to target test-api.creem.io with your test-mode key
# CREEM_TEST_MODE=false

# Public Creem product IDs
# NEXT_PUBLIC_CREEM_PRODUCT_STARTER_MONTHLY=prod_...
# NEXT_PUBLIC_CREEM_PRODUCT_PRO_MONTHLY=prod_...
# NEXT_PUBLIC_CREEM_PRODUCT_ENTERPRISE_MONTHLY=prod_...

# =============================================================================
# OPTIONAL: PREMIUM TEMPLATE PURCHASE
# -----------------------------------------------------------------------------
# This feature allows users to purchase the Premium version of ShipFree template.
# This is COMPLETELY SEPARATE from your application's payment system.
# Can be removed if not needed - see README for removal instructions.

# Stripe credentials for template purchases (separate from application payments)
# Get credentials from: https://dashboard.stripe.com/apikeys

# Public Stripe publishable key for template purchases

# Discord invite link for premium template purchasers
# Get from: https://discord.com/invite/your-server
