# =============================================================================
# VARIABLES DE ENTORNO EN VERCEL
# =============================================================================
# Este archivo NO se copia tal cual: es la lista de que poner en el panel de
# Vercel y con que ambito. No lleva secretos, por eso si va al repositorio.
#
# NO PEGUES .env AQUI. El .env local es para Docker y para Mailpit; varias de
# sus lineas son incorrectas, inertes o peligrosas fuera de tu maquina. Lo que
# cambia esta marcado abajo.
#
# La LISTA de claves que Vercel propone al importar el repo sale de las lineas
# NO comentadas de .env.example. Si agregas o quitas una variable, ajusta los
# dos archivos o la proxima importacion volvera a proponer el conjunto viejo.
#
# Ambitos de Vercel: marca cada variable para Production, Preview o ambas.
# Todas tienen que estar disponibles en BUILD, no solo en runtime: vercel.json
# corre `bun run migrate && bun run build`, asi que las migraciones se aplican
# durante el build.

# -----------------------------------------------------------------------------
# BASE DE DATOS  (distinta por ambito: production -> rama `production`,
#                 preview -> rama `preview`)
# -----------------------------------------------------------------------------
# SON DOS URLs DE LA MISMA BASE Y NO SON INTERCAMBIABLES.
#   DATABASE_URL         host CON -pooler   -> la app
#   DIRECT_DATABASE_URL  host SIN -pooler   -> `bun run migrate` en el build
#
# El pooler es PgBouncer en modo transaccion: la app tiene que ir por ahi o
# agota las conexiones, y las migraciones NO pueden porque son DDL dentro de
# una transaccion. scripts/migrate.ts avisa y sale con 1 si le das la pooled.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USUARIO:CLAVE@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# AUTENTICACION
# -----------------------------------------------------------------------------
# UNO NUEVO POR AMBITO. No reutilices el de tu .env local ni uses el mismo en
# production y preview: firma las cookies de sesion, y los previews son URLs
# publicas. Generalo con:  openssl rand -base64 32
#
# src/config/env.ts se niega a arrancar en produccion si detecta uno de los
# valores de ejemplo del repositorio.
BETTER_AUTH_SECRET=

# Better Auth receives getBaseUrl() explicitly and does not read
# BETTER_AUTH_URL. Do not configure the inert duplicate in Vercel.
# BETTER_AUTH_URL=https://tudominio.co

# Normally leave this unset: getBaseUrl() uses Vercel's stable production or
# branch URL. Set it only when deliberately overriding that public origin, then
# redeploy because NEXT_PUBLIC_* values are embedded during the build.
# NEXT_PUBLIC_APP_URL=https://tudominio.co

# Solo si el dia de manana la sesion tiene que cruzar subdominios, p. ej.
# .tumbenla.com. Un valor equivocado rompe el inicio de sesion entero.
# COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# COBROS DE COMERCIO — EPAYCO SMART CHECKOUT V2
# -----------------------------------------------------------------------------
# Required in both Preview and Production. Use separate ePayco credentials and
# config versions. Preview must use test/sandbox; Production must use live/real.
# Deploy first with new operations disabled, verify the build and public HTTPS
# response/confirmation routes, then enable and redeploy for the test window.
COMMERCE_PAYMENT_PROVIDER=epayco
COMMERCE_PAYMENT_ENVIRONMENT=<<<preview:test | production:live>>>
COMMERCE_FUNDING_CLASSIFICATION=<<<preview:sandbox | production:real>>>
COMMERCE_PAYMENT_CONFIG_VERSION=<<<unique-durable-version-for-this-environment>>>
COMMERCE_NEW_OPERATIONS_ENABLED=false
EPAYCO_PUBLIC_KEY=<<<epayco-public-key>>>
EPAYCO_PRIVATE_KEY=<<<epayco-private-key>>>
EPAYCO_CUSTOMER_ID=<<<epayco-customer-id>>>
EPAYCO_P_KEY=<<<epayco-p-key>>>
EPAYCO_MERCHANT_NAME=Tumbenla

# Secret JSON array for unresolved attempts created under rotated credentials.
# Leave empty until the first rotation; never delete a configuration still
# referenced by a pending attempt.
EPAYCO_PREVIOUS_CONFIGS_JSON=

# Generate a separate long random value for each environment. Vercel sends it
# as the Bearer token to /api/cron/commerce-recovery in Production.
CRON_SECRET=<<<long-random-secret>>>

# -----------------------------------------------------------------------------
# PANEL DE OPERACION
# -----------------------------------------------------------------------------
# Correos separados por coma. Falla cerrado: vacia o ausente significa que
# NADIE entra a /admin, incluido tu.
ADMIN_EMAILS=tu@correo.com

# OBLIGATORIA donde ADMIN_EMAILS este puesta. El admin se decide por el correo
# de la sesion, asi que sin verificacion alguien podria registrarse primero con
# tu direccion y heredar el panel.
EMAIL_VERIFICATION_ENABLED=true

# -----------------------------------------------------------------------------
# CORREO
# -----------------------------------------------------------------------------
# Una clave distinta por ambito, para poder revocar una sin tumbar la otra.
# Sin clave, en produccion el mailer cae al proveedor `log`: el correo se
# escribe en los logs y no se envia. Nadie recibe su verificacion.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
DEFAULT_FROM_NAME=Tumbenla
DEFAULT_REPLY_TO=hastaabajo@tumbenla.com

# NO pongas EMAIL_PROVIDER ni ninguna SMTP_*: apuntan al Mailpit local, que en
# Vercel no existe. Sin EMAIL_PROVIDER el mailer elige Resend solo.

# -----------------------------------------------------------------------------
# EVIDENCIA FINANCIERA — CLOUDFLARE R2
# -----------------------------------------------------------------------------
# Required to complete payment reconciliation/refund/payout acceptance. Use
# separate Preview and Production credentials and buckets. Originals belong in
# the private bucket; R2_STORAGE_BASE_URL serves only reviewed public copies.
CLOUDFLARE_ACCOUNT_ID=<<<cloudflare-account-id>>>
R2_ACCESS_KEY_ID=<<<r2-access-key-id>>>
R2_SECRET_ACCESS_KEY=<<<r2-secret-access-key>>>
R2_BUCKET_URL=<<<https://account-id.r2.cloudflarestorage.com>>>
R2_PUBLIC_BUCKET=<<<public-evidence-bucket>>>
R2_PRIVATE_BUCKET=<<<private-evidence-bucket>>>
R2_STORAGE_BASE_URL=<<<https://public-evidence-domain>>>

# -----------------------------------------------------------------------------
# LO QUE NO HAY QUE PONER
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENV        no se lee en ninguna parte del codigo.
# SENTRY_AUTH_TOKEN      inerte: withSentryConfig solo sube sourcemaps si
# NEXT_PUBLIC_SENTRY_DSN  SENTRY_ORG y SENTRY_PROJECT estan puestas, y el DSN
# SENTRY_DSN              esta CODIFICADO A MANO en sentry.server.config.ts,
#                         sentry.edge.config.ts e instrumentation-client.ts.
#                         Poner la variable no activa nada. Ver PRODUCT.md.
# NODE_ENV               la pone Vercel; ponerla a mano rompe cosas.
