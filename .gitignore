# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Las plantillas SI se versionan: no llevan secretos y son la unica
# documentacion de que variable va en cada ambiente.
!.env.example
!.env.vercel.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

opencode.json

# Sentry Config File
.env.sentry-build-plugin
config.bat
.claude/worktrees/
