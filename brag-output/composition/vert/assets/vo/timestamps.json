[{"i": 1, "text": "Vea,<break time=\"0.15s\" /> la vuelta es simple.", "dur": 1.376, "words": [["Vea,", 0.0, 0.559], ["la", 0.559, 0.634], ["vuelta", 0.667, 0.903], ["es", 0.924, 0.968], ["simple.", 0.989, 1.548]]}, {"i": 2, "text": "Entre a la página,<break time=\"0.15s\" /> mire cuáles bares le entraron a esta vuelta,<break time=\"0.15s\" /> y escoja uno.", "dur": 3.863, "words": [["Entre", 0.0, 0.205], ["a", 0.226, 0.247], ["la", 0.28, 0.322], ["página,", 0.366, 1.064], ["mire", 1.118, 1.257], ["cuáles", 1.29, 1.483], ["bares", 1.527, 1.709], ["le", 1.731, 1.774], ["entraron", 1.795, 2.043], ["a", 2.096, 2.118], ["esta", 2.161, 2.332], ["vuelta,", 2.365, 2.999], ["y", 2.999, 3.064], ["escoja", 3.129, 3.494], ["uno.", 3.58, 4.085]]}, {"i": 3, "text": "Párchese como siempre. Consumiendo ahí ya está poniendo,<break time=\"0.15s\" /> y las fotos le quedan de recuerdo.", "dur": 4.232, "words": [["Párchese", -0.046, 0.33], ["como", 0.362, 0.523], ["siempre.", 0.545, 0.932], ["Consumiendo", 0.964, 1.577], ["ahí", 1.642, 1.781], ["ya", 1.814, 1.878], ["está", 1.899, 2.029], ["poniendo,", 2.071, 2.803], ["y", 2.803, 2.867], ["las", 2.943, 3.05], ["fotos", 3.093, 3.319], ["le", 3.34, 3.394], ["quedan", 3.437, 3.608], ["de", 3.641, 3.684], ["recuerdo.", 3.738, 4.469]]}, {"i": 4, "text": "Después vuelva y mire cuánto puso usted.", "dur": 1.947, "words": [["Después", 0.0, 0.333], ["vuelva", 0.355, 0.742], ["y", 0.828, 0.903], ["mire", 0.956, 1.096], ["cuánto", 1.14, 1.387], ["puso", 1.43, 1.612], ["usted.", 1.634, 2.193]]}, {"i": 5, "text": "Nosotros compramos el material,<break time=\"0.15s\" /> y publicamos la factura.", "dur": 2.676, "words": [["Nosotros", -0.028, 0.317], ["compramos", 0.359, 0.681], ["el", 0.725, 0.768], ["material,", 0.8, 1.553], ["y", 1.553, 1.617], ["publicamos", 1.681, 2.111], ["la", 2.133, 2.176], ["factura.", 2.208, 2.896]]}, {"i": 6, "text": "Así usted sale,<break time=\"0.15s\" /> se parcha,<break time=\"0.15s\" /> rumbea,<break time=\"0.15s\" /> 